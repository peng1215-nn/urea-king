# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不要提交真实密钥。

# 数据库（必填）。本地和线上都用 PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/poker_dev

# 只给测试用的独立数据库（库名必须包含 test；测试会清空所有表）
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/poker_test

# 会话签名密钥（生产环境必填，缺失时应用拒绝启动）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# 运行环境：production / development / test。不填时，在 Render（或 Railway）上自动视为 production
APP_ENV=development

# 会话 Cookie 是否只走 HTTPS。不填时生产环境开启、本地关闭
# SESSION_HTTPS_ONLY=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 头像上传（Cloudinary）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 主域名首页
POKER_URL=https://poker.urea-king.com
ADMIN_CONTACT_EMAIL=admin@urea-king.com
